# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Variable files can contain secrets
*.tfvars
*.tfvars.json

# But allow checked-in non-secret environment examples if desired
!environments/*.example.tfvars

# Saved Terraform plans
*.tfplan
tfplan

# CLI config files
.terraformrc
terraform.rc

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/